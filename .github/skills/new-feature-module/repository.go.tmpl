package __PACKAGE__

import (
	"context"
	"fmt"
	"sort"
	"sync"
	"time"

	"github.com/ynwd/flow/core/ulid"
)

const (
	// maxItems limits the in-memory store to prevent OOM.
	maxItems = 10000

	// defaultTTL is how long each item lives before being eligible for cleanup.
	defaultTTL = 24 * time.Hour

	// cleanupInterval is how often the cleanup goroutine runs.
	cleanupInterval = 5 * time.Minute
)

// ErrStoreFull is returned when the in-memory store has reached maxItems.
var ErrStoreFull = fmt.Errorf("store full: max %d items", maxItems)

// itemWithTTL wraps an item with an expiry timestamp.
type itemWithTTL struct {
	data      __FEATURE_TITLE__
	expiresAt time.Time
}

// Repository handles data access for the __FEATURE__ module.
type Repository struct {
	mu         sync.RWMutex
	items      map[string]itemWithTTL
	stopCleanup chan struct{}
}

// NewRepository creates a new Repository and starts the background cleanup goroutine.
func NewRepository() *Repository {
	r := &Repository{
		items:       make(map[string]itemWithTTL),
		stopCleanup: make(chan struct{}),
	}
	go r.cleanup()
	return r
}

// Stop halts the background cleanup goroutine. Call during graceful shutdown.
func (r *Repository) Stop() {
	close(r.stopCleanup)
}

// cleanup periodically removes expired items.
func (r *Repository) cleanup() {
	ticker := time.NewTicker(cleanupInterval)
	defer ticker.Stop()
	for {
		select {
		case <-ticker.C:
			r.mu.Lock()
			now := time.Now()
			for id, item := range r.items {
				if now.After(item.expiresAt) {
					delete(r.items, id)
				}
			}
			r.mu.Unlock()
		case <-r.stopCleanup:
			return
		}
	}
}

func (r *Repository) Create(ctx context.Context, title, content, author string) (__FEATURE_TITLE__, error) {
	r.mu.Lock()
	defer r.mu.Unlock()

	if len(r.items) >= maxItems {
		return __FEATURE_TITLE__{}, ErrStoreFull
	}

	item := __FEATURE_TITLE__{
		ID:        ulid.New(),
		Title:     title,
		Content:   content,
		Author:    author,
		CreatedAt: time.Now(),
		UpdatedAt: time.Now(),
	}
	r.items[item.ID] = itemWithTTL{data: item, expiresAt: time.Now().Add(defaultTTL)}
	return item, nil
}

func (r *Repository) Update(ctx context.Context, id, title, content string) (__FEATURE_TITLE__, error) {
	r.mu.Lock()
	defer r.mu.Unlock()

	wrapped, ok := r.items[id]
	if !ok {
		return __FEATURE_TITLE__{}, fmt.Errorf("%s: not found", id)
	}
	wrapped.data.Title = title
	wrapped.data.Content = content
	wrapped.data.UpdatedAt = time.Now()
	r.items[id] = wrapped
	return wrapped.data, nil
}

// List returns a paginated slice of items. Use limit=0 for default (50).
func (r *Repository) List(ctx context.Context, limit, offset int) ([]__FEATURE_TITLE__, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	if limit <= 0 {
		limit = 50
	}

	// Collect and sort all items
	all := make([]__FEATURE_TITLE__, 0, len(r.items))
	for _, item := range r.items {
		all = append(all, item.data)
	}
	sort.Slice(all, func(i, j int) bool {
		return all[i].CreatedAt.After(all[j].CreatedAt)
	})

	// Apply pagination
	if offset >= len(all) {
		return []__FEATURE_TITLE__{}, nil
	}
	end := offset + limit
	if end > len(all) {
		end = len(all)
	}
	return all[offset:end], nil
}

func (r *Repository) GetByID(ctx context.Context, id string) (__FEATURE_TITLE__, error) {
	r.mu.RLock()
	defer r.mu.RUnlock()

	wrapped, ok := r.items[id]
	if !ok {
		return __FEATURE_TITLE__{}, fmt.Errorf("%s: not found", id)
	}
	return wrapped.data, nil
}

func (r *Repository) Delete(ctx context.Context, id string) error {
	r.mu.Lock()
	defer r.mu.Unlock()

	if _, ok := r.items[id]; !ok {
		return fmt.Errorf("%s: not found", id)
	}
	delete(r.items, id)
	return nil
}

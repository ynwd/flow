package ulid

import (
	"testing"
)

func TestNew_GeneratesValidULID(t *testing.T) {
	id := New()
	if len(id) != 26 {
		t.Errorf("expected 26-char ULID, got %d chars: %s", len(id), id)
	}
}

func TestNew_Unique(t *testing.T) {
	seen := make(map[string]bool, 100)
	for i := 0; i < 100; i++ {
		id := New()
		if seen[id] {
			t.Fatalf("duplicate ULID generated: %s", id)
		}
		seen[id] = true
	}
}

func TestNew_NonEmpty(t *testing.T) {
	id := New()
	if id == "" {
		t.Error("expected non-empty ULID")
	}
}

package router

import (
	"net/http"
	"net/http/httptest"
	"os"
	"testing"
)

// testModule is a minimal Module implementation for testing.
type testModule struct {
	name   string
	routes []Route
}

func (m *testModule) Name() string    { return m.name }
func (m *testModule) Routes() []Route { return m.routes }

// resetModules clears all registered modules between tests.
func resetModules() {
	mu.Lock()
	defer mu.Unlock()
	modules = make(map[string]Module)
}

func TestRegisterModule(t *testing.T) {
	resetModules()

	mod := &testModule{
		name: "test",
		routes: []Route{
			{Method: "GET", Path: "/test", Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {})},
		},
	}

	RegisterModule(mod)

	registered := GetModules()
	if len(registered) != 1 {
		t.Fatalf("expected 1 module, got %d", len(registered))
	}
	if _, ok := registered["test"]; !ok {
		t.Error("expected 'test' module to be registered")
	}
}

func TestRegisterMultipleModules(t *testing.T) {
	resetModules()

	RegisterModule(&testModule{name: "a"})
	RegisterModule(&testModule{name: "b"})
	RegisterModule(&testModule{name: "c"})

	registered := GetModules()
	if len(registered) != 3 {
		t.Fatalf("expected 3 modules, got %d", len(registered))
	}
}

func TestGetModulesReturnsCopy(t *testing.T) {
	resetModules()

	RegisterModule(&testModule{name: "original"})

	copied := GetModules()
	delete(copied, "original") // Mutate the copy

	// Original should be unaffected
	original := GetModules()
	if len(original) != 1 {
		t.Error("GetModules should return a copy, not the original map")
	}
}

func TestBuildRouter_LandingPage(t *testing.T) {
	resetModules()

	mux := http.NewServeMux()
	BuildRouter(mux)

	req := httptest.NewRequest(http.MethodGet, "/", nil)
	rec := httptest.NewRecorder()
	mux.ServeHTTP(rec, req)

	if rec.Code != http.StatusOK {
		t.Errorf("expected 200, got %d", rec.Code)
	}
	if ct := rec.Header().Get("Content-Type"); ct != "text/html; charset=utf-8" {
		t.Errorf("expected text/html, got %s", ct)
	}
}

func TestBuildRouter_RedirectToFirstModule(t *testing.T) {
	resetModules()

	RegisterModule(&testModule{
		name: "blog",
		routes: []Route{
			{Method: "GET", Path: "/blog", Description: "Blog list", Access: AccessPublic, Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				w.WriteHeader(http.StatusOK)
			})},
		},
	})

	mux := http.NewServeMux()
	BuildRouter(mux)

	req := httptest.NewRequest(http.MethodGet, "/", nil)
	rec := httptest.NewRecorder()
	mux.ServeHTTP(rec, req)

	if rec.Code != http.StatusFound {
		t.Errorf("expected 302 redirect, got %d", rec.Code)
	}
	if loc := rec.Header().Get("Location"); loc != "/blog" {
		t.Errorf("expected redirect to /blog, got %s", loc)
	}
}

func TestBuildRouter_ModuleRoutes(t *testing.T) {
	resetModules()

	RegisterModule(&testModule{
		name: "api",
		routes: []Route{
			{Method: "GET", Path: "/api/health", Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
				w.WriteHeader(http.StatusOK)
				//nolint:errcheck // test handler
				_, _ = w.Write([]byte("ok"))
			})},
		},
	})

	mux := http.NewServeMux()
	BuildRouter(mux)

	req := httptest.NewRequest(http.MethodGet, "/api/health", nil)
	rec := httptest.NewRecorder()
	mux.ServeHTTP(rec, req)

	if rec.Code != http.StatusOK {
		t.Errorf("expected 200, got %d", rec.Code)
	}
	if rec.Body.String() != "ok" {
		t.Errorf("expected 'ok', got '%s'", rec.Body.String())
	}
}

func TestCachedFileServer_CacheControl(t *testing.T) {
	// Create a temp directory with a test file
	dir := t.TempDir()
	if err := os.WriteFile(dir+"/test.txt", []byte("hello"), 0o644); err != nil {
		t.Fatal(err)
	}

	handler := cachedFileServer(dir, "")

	req := httptest.NewRequest(http.MethodGet, "/test.txt", nil)
	rec := httptest.NewRecorder()
	handler.ServeHTTP(rec, req)

	cc := rec.Header().Get("Cache-Control")
	if cc != "public, max-age=3600, immutable" {
		t.Errorf("expected 3600 cache, got %s", cc)
	}
}

func TestCachedFileServer_CSSMimeType(t *testing.T) {
	dir := t.TempDir()
	if err := os.WriteFile(dir+"/style.css", []byte("body{}"), 0o644); err != nil {
		t.Fatal(err)
	}

	handler := cachedFileServer(dir, "")

	req := httptest.NewRequest(http.MethodGet, "/static/style.css", nil)
	rec := httptest.NewRecorder()
	handler.ServeHTTP(rec, req)

	ct := rec.Header().Get("Content-Type")
	if ct != "text/css; charset=utf-8" {
		t.Errorf("expected text/css, got %s", ct)
	}
}

func TestCachedFileServer_DistLongCache(t *testing.T) {
	dir := t.TempDir()
	if err := os.MkdirAll(dir+"/dist", 0o755); err != nil {
		t.Fatal(err)
	}
	if err := os.WriteFile(dir+"/dist/app.js", []byte("console.log()"), 0o644); err != nil {
		t.Fatal(err)
	}

	handler := cachedFileServer(dir, "")

	req := httptest.NewRequest(http.MethodGet, "/static/dist/app.js", nil)
	rec := httptest.NewRecorder()
	handler.ServeHTTP(rec, req)

	cc := rec.Header().Get("Cache-Control")
	if cc != "public, max-age=31536000, immutable" {
		t.Errorf("expected 31536000 cache for dist/, got %s", cc)
	}
}
